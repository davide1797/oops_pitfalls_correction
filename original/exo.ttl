[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:ExO_0000004 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A exposure transport path is the course an agent takes from the source to the target." ;
   oboInOwl:hasDbXref "CTD:curators"
 ] .


###  http://purl.obolibrary.org/obo/ExO_0000005
obo:ExO_0000005 rdf:type owl:Class ;
                rdfs:subClassOf obo:ExO_0000000 ;
                obo:IAO_0000115 "An agent of biological origin." ;
                oboInOwl:created_by "cmattin" ;
