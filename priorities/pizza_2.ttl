:hasBase rdfs:domain :Pizza ;
    rdfs:range :PizzaBase ;
    owl:inverseOf :isBaseOf .

:hasIngredient rdfs:domain :Food ;
    rdfs:range :Food ;
    owl:inverseOf :isIngredientOf .

:hasSpiciness rdfs:range :Spiciness .

:hasTopping rdfs:domain :Pizza ;
    rdfs:range :PizzaTopping ;
    owl:inverseOf :isToppingOf .

:Spiciness rdfs:label "Tempero"@pt .

:isBaseOf rdfs:domain :PizzaBase ;
    rdfs:range :Pizza .

:isIngredientOf rdfs:domain :Food ;
    rdfs:range :Food .

:isToppingOf rdfs:domain :PizzaTopping ;
    rdfs:range :Pizza .

:PizzaBase rdfs:label "BaseDaPizza"@pt .

:PizzaTopping rdfs:label "CoberturaDaPizza"@pt .

:Pizza rdfs:label "Pizza"@en .

