@prefix : <http://www.ontotext.com/proton/protontop#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

dc:creator a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dc:subject a owl:AnnotationProperty .

dc:title a owl:AnnotationProperty .

<http://www.ontotext.com/proton/protontop> a owl:Ontology ;
    rdfs:label "Proton Ontology" .

:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:subClassOf :Happening .

:GeneralTerm a owl:Class ;
    rdfs:label "General Term"@en ;
    rdfs:subClassOf :Abstract .

:Number a owl:Class ;
    rdfs:label "Number"@en ;
    rdfs:subClassOf :Abstract .

:TimeInterval a owl:Class ;
    rdfs:label "Time Interval"@en ;
    rdfs:subClassOf :Happening .

:controls a owl:ObjectProperty ;
    rdfs:label "Controls"@en ;
    rdfs:subPropertyOf :partiallyControls .

:derivedFromSource a owl:ObjectProperty ;
    rdfs:label "Derived from Source"@en ;
    rdfs:domain :InformationResource ;
    rdfs:range :InformationResource .

:documentAbstract a owl:DatatypeProperty ;
    rdfs:label "Document Abstract"@en ;
    rdfs:domain :Document ;
    rdfs:subPropertyOf :description .

:documentAuthor a owl:ObjectProperty ;
    rdfs:label "Document Author"@en ;
    rdfs:range :Agent ;
    rdfs:subPropertyOf :hasCreator .

:documentSubTitle a owl:DatatypeProperty ;
    rdfs:label "Document Subtitle"@en ;
    rdfs:domain :Document ;
    rdfs:subPropertyOf :laconicDescription .

:doingBusinessAs a owl:DatatypeProperty ;
    rdfs:label "Doing Business as"@en ;
    rdfs:domain :Organization ;
    rdfs:subPropertyOf :name .

:establishedIn a owl:ObjectProperty ;
    rdfs:label "Established in"@en ;
    rdfs:domain :Organization ;
    rdfs:subPropertyOf :locatedIn .

:establishmentDate a owl:DatatypeProperty ;
    rdfs:label "Establishment Date"@en ;
    rdfs:domain :Organization .

:firstName a owl:DatatypeProperty ;
    rdfs:label "First Name"@en ;
    rdfs:domain :Person ;
    rdfs:subPropertyOf :name .

:givenName a owl:DatatypeProperty ;
    rdfs:label "Given Name"@en ;
    rdfs:domain :Person ;
    rdfs:subPropertyOf :name .

:hasChild a owl:ObjectProperty ;
    rdfs:label "has Child"@en ;
    rdfs:subPropertyOf :hasRelative ;
    owl:inverseOf :hasParent .

:hasContactInfo a owl:ObjectProperty ;
    rdfs:label "has Contact Info"@en ;
    rdfs:domain :Object ;
    rdfs:range :ContactInformation .

:hasDate a owl:DatatypeProperty ;
    rdfs:label "has Date"@en ;
    rdfs:domain :InformationResource .

:hasEmployee a owl:ObjectProperty ;
    rdfs:label "has Employee"@en ;
    rdfs:range :Person ;
    rdfs:subPropertyOf :hasMember .

:hasLeader a owl:ObjectProperty ;
    rdfs:label "has Leader"@en ;
    rdfs:range :Person ;
    rdfs:subPropertyOf :hasMember .

:hasOldName a owl:DatatypeProperty ;
    rdfs:label "has Old Name"@en ;
    rdfs:subPropertyOf :name .

:hasParticipant a owl:ObjectProperty ;
    rdfs:label "Participant in a Happening"@en ;
    rdfs:domain :Happening ;
    rdfs:range :Agent ;
    rdfs:subPropertyOf :hasParticipatingEntity ;
    owl:inverseOf :involvedIn .

:hasPosition a owl:ObjectProperty ;
    rdfs:label "has Position"@en ;
    rdfs:domain :Person ;
    rdfs:range :JobPosition ;
    owl:inverseOf :holder .

:hasSibling a owl:ObjectProperty ;
    rdfs:label "has Sibling"@en ;
    rdfs:subPropertyOf :hasRelative .

:hasSocialPosition a owl:ObjectProperty ;
    rdfs:label "has Social Position"@en ;
    rdfs:domain :Person ;
    rdfs:range :SocialPosition ;
    owl:inverseOf :socialPositionHolder .

:hasSpouse a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has Spouse"@en ;
    rdfs:subPropertyOf :hasRelative .

:hasSubject a owl:ObjectProperty ;
    rdfs:label "has Subject"@en ;
    rdfs:domain :InformationResource ;
    rdfs:range :Topic .

:heldFrom a owl:DatatypeProperty ;
    rdfs:label "Held from"@en ;
    rdfs:domain :JobPosition ;
    rdfs:subPropertyOf :startTime .

:heldTo a owl:DatatypeProperty ;
    rdfs:label "Held to"@en ;
    rdfs:domain :JobPosition ;
    rdfs:subPropertyOf :endTime .

:inLanguage a owl:ObjectProperty ;
    rdfs:label "in Language"@en ;
    rdfs:domain :InformationResource ;
    rdfs:range :Language .

:informationResourceCoverage a owl:DatatypeProperty ;
    rdfs:label "Information Resource Coverage"@en ;
    rdfs:domain :InformationResource .

:informationResourceIdentifier a owl:DatatypeProperty ;
    rdfs:label "Information Resource Identifier"@en ;
    rdfs:domain :InformationResource .

:informationResourceRights a owl:DatatypeProperty ;
    rdfs:label "Information Resource Rights"@en ;
    rdfs:domain :InformationResource .

:isBossOf a owl:ObjectProperty ;
    rdfs:label "is Boss of"@en ;
    rdfs:domain :Person ;
    rdfs:range :Person .

:isLegalEntity a owl:DatatypeProperty ;
    rdfs:label "is Legal Entity"@en ;
    rdfs:domain :Agent .

:isOwnedBy a owl:ObjectProperty ;
    rdfs:label "is Owned by"@en ;
    rdfs:domain :Object ;
    rdfs:range :Agent .

:lastName a owl:DatatypeProperty ;
    rdfs:label "Last Name"@en ;
    rdfs:domain :Person ;
    rdfs:subPropertyOf :name .

:latitude a owl:DatatypeProperty ;
    rdfs:label "Latitude"@en ;
    rdfs:domain :Location .

:longitude a owl:DatatypeProperty ;
    rdfs:label "Longitude"@en ;
    rdfs:domain :Location .

:mainLabel a owl:DatatypeProperty ;
    rdfs:label "Main Label"@en ;
    rdfs:domain :Entity ;
    rdfs:range rdfs:Literal .

:nimaGNSDesignator a owl:DatatypeProperty ;
    rdfs:label "NIMA GNS Designator"@en ;
    rdfs:domain :Location .

:nimaGNSUniqueFeatureIndentifier a owl:DatatypeProperty ;
    rdfs:label "NIMA GNS Unique Feature Identifier"@en ;
    rdfs:domain :Location .

:numberOfEmployees a owl:DatatypeProperty ;
    rdfs:label "Number of Employees"@en ;
    rdfs:domain :Organization .

:operatedBy a owl:ObjectProperty ;
    rdfs:label "Operated by"@en ;
    rdfs:domain :Service ;
    rdfs:range :Agent .

:owns a owl:ObjectProperty ;
    rdfs:label "Owns"@en ;
    rdfs:subPropertyOf :partiallyOwns .

:parentOrganizationOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "Parent Organization of"@en ;
    rdfs:domain :Organization ;
    rdfs:range :Organization ;
    rdfs:subPropertyOf :partiallyControls ;
    owl:inverseOf :subsidiaryOrganizationOf .

:populationCount a owl:DatatypeProperty ;
    rdfs:label "Population Count"@en ;
    rdfs:domain :Location .

:producedBy a owl:ObjectProperty ;
    rdfs:label "Produced by"@en ;
    rdfs:domain :ProductModel ;
    rdfs:range :Agent .

:registeredIn a owl:ObjectProperty ;
    rdfs:label "Registered in"@en ;
    rdfs:domain :Organization ;
    rdfs:subPropertyOf :locatedIn .

:resourceFormat a owl:DatatypeProperty ;
    rdfs:label "Resource Format"@en ;
    rdfs:domain :InformationResource .

:resourceType a owl:DatatypeProperty ;
    rdfs:label "Resource Type"@en ;
    rdfs:domain :InformationResource .

:roleHolder a owl:ObjectProperty ;
    rdfs:label "Role Holder"@en ;
    rdfs:domain :Role ;
    rdfs:range :Entity .

:roleIn a owl:ObjectProperty ;
    rdfs:label "Role in"@en ;
    rdfs:domain :Role ;
    rdfs:range :Happening .

:statedBy a owl:ObjectProperty ;
    rdfs:label "Stated by"@en ;
    rdfs:domain :Statement ;
    rdfs:range :Agent .

:subRegionOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "Subregion of"@en ;
    rdfs:domain :Location ;
    rdfs:subPropertyOf :locatedIn,
        :partOf .

:subTopicOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "Subtopic of"@en ;
    rdfs:domain :Topic ;
    rdfs:range :Topic .

:systemPrimitive a owl:AnnotationProperty ;
    rdfs:label "System Primitive"@en .

:title a owl:DatatypeProperty ;
    rdfs:label "Title"@en ;
    rdfs:domain :InformationResource ;
    rdfs:subPropertyOf :name .

:transitiveOver a owl:AnnotationProperty ;
    rdfs:label "Transitive over"@en .

:validFrom a owl:DatatypeProperty ;
    rdfs:label "Valid from"@en ;
    rdfs:domain :Statement .

:validUntil a owl:DatatypeProperty ;
    rdfs:label "Valid until"@en ;
    rdfs:domain :Statement .

:withinOrganization a owl:ObjectProperty ;
    rdfs:label "within Organization"@en ;
    rdfs:domain :JobPosition ;
    rdfs:range :Organization .

rdfs:comment a owl:AnnotationProperty .

rdfs:label a owl:AnnotationProperty .

owl:versionInfo a owl:AnnotationProperty .

:ContactInformation a owl:Class ;
    rdfs:label "Contact Information"@en ;
    rdfs:subClassOf :Abstract .

:Language a owl:Class ;
    rdfs:label "Language"@en ;
    rdfs:subClassOf :Abstract .

:ProductModel a owl:Class ;
    rdfs:label "Product Model"@en ;
    rdfs:subClassOf :Object .

:Service a owl:Class ;
    rdfs:label "Service"@en ;
    rdfs:subClassOf :Object .

:endTime a owl:DatatypeProperty ;
    rdfs:label "End Time"@en ;
    rdfs:domain :Happening .

:hasContributor a owl:ObjectProperty ;
    rdfs:label "has Contributor"@en ;
    rdfs:domain :InformationResource ;
    rdfs:range :Agent .

:hasCreator a owl:ObjectProperty ;
    rdfs:label "has Creator"@en ;
    rdfs:subPropertyOf :hasContributor .

:hasParent a owl:ObjectProperty ;
    rdfs:label "has Parent"@en ;
    rdfs:subPropertyOf :hasRelative .

:hasParticipatingEntity a owl:ObjectProperty ;
    rdfs:label "Entity Participating in a Happening"@en ;
    rdfs:domain :Happening ;
    rdfs:range :Entity ;
    owl:inverseOf :involvedEntityIn .

:holder a owl:ObjectProperty ;
    rdfs:label "Holder"@en ;
    rdfs:domain :JobPosition ;
    rdfs:range :Person .

:involvedIn a owl:ObjectProperty ;
    rdfs:label "Involved in"@en ;
    rdfs:domain :Agent,
        :Entity ;
    rdfs:range :Happening ;
    rdfs:subPropertyOf :involvedEntityIn .

:laconicDescription a owl:DatatypeProperty ;
    rdfs:label "Laconic Description"@en ;
    rdfs:subPropertyOf :description .

:partiallyOwns a owl:ObjectProperty ;
    rdfs:label "Partially Owns"@en ;
    rdfs:subPropertyOf :partiallyControls .

:socialPositionHolder a owl:ObjectProperty ;
    rdfs:label "Social Position Holder"@en ;
    rdfs:domain :SocialPosition ;
    rdfs:range :Person .

:startTime a owl:DatatypeProperty ;
    rdfs:label "Start Time"@en ;
    rdfs:domain :Happening .

:subsidiaryOrganizationOf a owl:ObjectProperty ;
    rdfs:label "Subsidiary Organization of"@en ;
    rdfs:domain :Organization ;
    rdfs:range :Organization ;
    rdfs:subPropertyOf :partOf .

:Document a owl:Class ;
    rdfs:label "Document"@en ;
    rdfs:subClassOf :InformationResource .

:Group a owl:Class ;
    rdfs:label "Group"@en ;
    rdfs:subClassOf :Agent .

:Role a owl:Class ;
    rdfs:label "Role"@en ;
    rdfs:subClassOf :Situation .

:Situation a owl:Class ;
    rdfs:label "Situation"@en ;
    rdfs:subClassOf :Happening .

:description a owl:DatatypeProperty ;
    rdfs:label "Description"@en ;
    rdfs:domain :Entity .

:hasMember a owl:ObjectProperty ;
    rdfs:label "has Member"@en ;
    rdfs:domain :Group ;
    rdfs:range :Agent .

:involvedEntityIn a owl:ObjectProperty ;
    rdfs:label "Entity Involved in"@en ;
    rdfs:domain :Entity ;
    rdfs:range :Happening .

:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "Part of"@en ;
    rdfs:domain :Entity ;
    rdfs:range :Entity .

:SocialPosition a owl:Class ;
    rdfs:label "Social Position"@en ;
    rdfs:subClassOf :Situation .

:Topic a owl:Class ;
    rdfs:label "Topic"@en ;
    rdfs:subClassOf :Abstract .

:locatedIn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "Located in"@en ;
    rdfs:domain :Entity ;
    rdfs:range :Location .

:partiallyControls a owl:ObjectProperty ;
    rdfs:label "Partially Controls"@en ;
    rdfs:domain :Agent ;
    rdfs:range :Object .

:Statement a owl:Class ;
    rdfs:label "Statement"@en ;
    rdfs:subClassOf :Object .

:hasRelative a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has Relative"@en ;
    rdfs:domain :Person ;
    rdfs:range :Person .

:Abstract a owl:Class ;
    rdfs:label "Abstract"@en ;
    rdfs:subClassOf :Entity .

:JobPosition a owl:Class ;
    rdfs:label "Job Position"@en ;
    rdfs:subClassOf :SocialPosition .

:name a owl:DatatypeProperty ;
    rdfs:label "Name of any kind"@en ;
    rdfs:domain :Entity ;
    rdfs:range rdfs:Literal .

:Location a owl:Class ;
    rdfs:label "Location"@en ;
    rdfs:subClassOf :Object .

:Object a owl:Class ;
    rdfs:label "Object"@en ;
    rdfs:subClassOf :Entity .

:Happening a owl:Class ;
    rdfs:label "Happening"@en ;
    rdfs:subClassOf :Entity .

:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:subClassOf :Group .

:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:subClassOf :Object .

:Entity a owl:Class ;
    rdfs:label "Entity"@en .

:InformationResource a owl:Class ;
    rdfs:label "Information Resource"@en ;
    rdfs:subClassOf :Statement .

:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:subClassOf :Agent .

