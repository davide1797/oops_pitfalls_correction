 ] .


###  http://purl.obolibrary.org/obo/ExO_0000007
obo:ExO_0000007 rdf:type owl:Class ;
                rdfs:subClassOf obo:ExO_0000000 ;
                obo:IAO_0000115 "An exposure stressor that is a change in the distributions, abundance and relations of organisms and their interactions with the environment." ;
                oboInOwl:created_by "cmattin" ;
                oboInOwl:creation_date "2010-09-21T10:14:38Z" ;
                oboInOwl:hasOBONamespace "exposure_stressor" ;
                oboInOwl:id "ExO:0000007" ;
                rdfs:label "ecological perturbation" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:ExO_0000007 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "An exposure stressor that is a change in the distributions, abundance and relations of organisms and their interactions with the environment." ;
   oboInOwl:hasDbXref "google:google"
 ] .


###  http://purl.obolibrary.org/obo/ExO_0000008
obo:ExO_0000008 rdf:type owl:Class ;
                rdfs:subClassOf obo:ExO_0000000 ;
                obo:IAO_0000115 "An agent as a source of energy that may cause injury or disease (e.g., noise, vibration, radiation, temperature extremes)." ;
