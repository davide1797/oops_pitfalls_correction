ontopfas:Pfaa rdf:type owl:Class ;
rdfs:subClassOf obo:CHEBI_24531 ,
rdfs:label "Pfaa" ;
skos:definition "Perfluoroalkyl acids (PFAAs) are a subclass of PFAS that have a fully fluorinated carbon chain (no hydrogen atoms attached to the carbon backbone) ending with a functional acid group — either a carboxylic acid (-COOH) or a sulfonic acid (-SO₃H) group." .
ontopfas:Pfas rdf:type owl:Class ;
rdfs:subClassOf obo:CHEBI_24431 ;
rdfs:label "Pfas" ;
skos:definition "Per- and poly- fluoroalkyl substance." .
ontopfas:PfasMobility rdf:type owl:Class ;
rdfs:label "Pfas mobility" ;
skos:definition "Degree of mobility associated with the PFAS." .
ontopfas:PfasPrecursor rdf:type owl:Class ;
rdfs:subClassOf ontopfas:Pfas ;
rdfs:label "Precursor" ;
skos:definition "Precursor PFAS are compounds that can transform — through biological, chemical, or environmental processes — into perfluoroalkyl acids (PFAAs) such as PFOA or PFOS." .
ontopfas:Pfca rdf:type owl:Class ;
rdfs:subClassOf ontopfas:Pfaa ;
rdfs:label "Pfca" ;
skos:definition "PFCAs are PFAAs that end with a carboxylic acid functional group (-COOH). Their general formula is CₙF₂ₙ₊₁COOH, where n is typically between 4 and 14." .
ontopfas:Pfoa rdf:type owl:Class ;
rdfs:subClassOf ontopfas:LongChainPfas ,
rdfs:label "Pfoa" ;
skos:definition "PFOA is a specific PFCA with the formula C₇F₁₅COOH (eight carbon atoms)." .
ontopfas:Pfos rdf:type owl:Class ;
rdfs:subClassOf ontopfas:LongChainPfas ,
rdfs:label "Pfos" ;
skos:definition "PFOS is a specific PFSA with the formula C₈F₁₇SO₃H." .
ontopfas:Pfsa rdf:type owl:Class ;
rdfs:subClassOf ontopfas:Pfaa ;
rdfs:label "Pfsa" ;
skos:definition "PFSAs are PFAAs that end with a sulfonic acid functional group (-SO₃H). Their general formula is CₙF₂ₙ₊₁SO₃H." .
ontopfas:PhysicalObject rdf:type owl:Class ;
rdfs:subClassOf <http://www.w3.org/ns/dcat#Dataset> .
