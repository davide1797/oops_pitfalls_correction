@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mod: <https://w3id.org/mod#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix ontopfas: <https://w3id.org/OntoPFAS#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix wgs: <https://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.allotrope.org/ontologies/property#AFX_0001048> a owl:ObjectProperty ;
    rdfs:label "contains" ;
    owl:inverseOf <http://purl.allotrope.org/ontologies/property#AFX_0001049> ;
    skos:definition "The relation between a container and its physical content. A material entity a contains a material entity b if b is located in some cavity of a." .

obo:CHEBI_172406 a owl:Class ;
    rdfs:label "Polyfluoroalkyl" ;
    rdfs:subClassOf ontopfas:Pfas .

obo:CHEBI_83814 a owl:Class ;
    rdfs:label "Fluorotelomer" ;
    rdfs:subClassOf ontopfas:PfasPrecursor ;
    skos:definition "Any organofluorine compound that is a oligomer or telomer synthesised by telomerization (a chain transfer reaction to produce an oligomer of a limited size). They are generally used in fire-fighting foams, leather protectants, food packaging and stain resistants." .

obo:ExO_0000043 a owl:Class ;
    rdfs:label "Anatomy" ;
    rdfs:subClassOf obo:ExO_0000101 .

obo:ExO_0000079 a owl:Class ;
    rdfs:label "Disease" ;
    rdfs:subClassOf obo:ExO_0000077 .

obo:ExO_0000080 a owl:Class ;
    rdfs:label "Symptom" ;
    rdfs:subClassOf obo:ExO_0000077 .

obo:ExO_0000087 a owl:Class ;
    rdfs:label "Exposure intervention" ;
    rdfs:subClassOf obo:ExO_0000003 .

obo:IAO_0000114 a owl:AnnotationProperty .

obo:IAO_0000115 a owl:AnnotationProperty .

obo:RO_0001015 a owl:ObjectProperty ;
    rdfs:label "location of" ;
    owl:inverseOf obo:RO_0001025 ;
    skos:definition "A relation between two independent continuants, the target and the location, in which the target is entirely within the location." .

obo:RO_0002020 a owl:ObjectProperty ;
    rdfs:label "transports" ;
    owl:inverseOf ontopfas:transportedBy ;
    skos:definition "Holds between p and c when p is a transport process or transporter activity and the outcome of this p is to move c from one location to another." .

obo:RO_0002170 a owl:ObjectProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "connected to" ;
    skos:definition "A is connected to b if and only if a and b are discrete structure, and there exists some connecting structure c, such that c connects a and b." .

obo:RO_0002309 a owl:ObjectProperty ;
    rdfs:label "has exposure stimulus" ;
    owl:inverseOf ontopfas:exposureStimulusOf ;
    skos:definition "A relationship between an exposure event or process and any agent, stimulus, activity, or event that causally effects an organism and interacts with an exposure receptor during an exposure event." .

obo:RO_0002494 a owl:ObjectProperty ;
    rdfs:label "transformation of" ;
    owl:inverseOf <http://semanticscience.org/resource/SIO_000655> ;
    skos:definition "x transformation of y if x is the immediate transformation of y, or is linked to y through a chain of transformation relationships" .

obo:RO_0003000 a owl:ObjectProperty ;
    rdfs:label "produces" ;
    owl:inverseOf obo:RO_0003001 ;
    skos:definition "a produces b if some process that occurs_in a has_output b, where a and b are material entities. Examples: hybridoma cell line produces monoclonal antibody reagent; chondroblast produces avascular GAG-rich matrix." .

obo:RO_0003302 a owl:ObjectProperty ;
    rdfs:label "causes" ;
    owl:inverseOf obo:SCDO_1000202 ;
    skos:definition "A relationship between an entity (e.g. a genotype, genetic variation, chemical, or environmental exposure) and a condition (a phenotype or disease), where the entity has some causal or contributing role that influences the condition." .

dcterms:accessRights a owl:AnnotationProperty .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "source" ;
    rdfs:range dcat:Dataset ;
    owl:inverseOf ontopfas:source_of ;
    skos:definition "A related resource from which the described resource is derived." .

dcterms:title a owl:AnnotationProperty .

pav:version a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

<http://semanticscience.org/resource/SIO_000652> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is directly connected to" ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:definition "A is directly connected to B iff there exists a path direclty between A and B." .

swrla:isRuleEnabled a owl:AnnotationProperty .

oboInOwl:created_by a owl:AnnotationProperty .

oboInOwl:creation_date a owl:AnnotationProperty .

oboInOwl:hasDbXref a owl:AnnotationProperty .

oboInOwl:hasExactSynonym a owl:AnnotationProperty .

oboInOwl:hasOBONamespace a owl:AnnotationProperty .

oboInOwl:hasRelatedSynonym a owl:AnnotationProperty .

oboInOwl:id a owl:AnnotationProperty .

oboInOwl:inSubset a owl:AnnotationProperty .

xsd:datetime a rdfs:Datatype .

skos:altLabel a owl:AnnotationProperty .

skos:changeNote a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:editorialNote a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

skos:notation a owl:AnnotationProperty .

skos:scopeNote a owl:AnnotationProperty .

odrl:hasPolicy a owl:AnnotationProperty .

prov:wasGeneratedBy a owl:AnnotationProperty .

sosa:hasSimpleResult a owl:DatatypeProperty ;
    rdfs:label "has simple result"@en ;
    rdfs:domain sosa:Observation ;
    rdfs:range owl:real ;
    skos:definition "The simple value of an Observation or Actuation."@en .

sosa:resultTime a owl:DatatypeProperty ;
    rdfs:label "result time"@en ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:dateTime ;
    skos:definition "The result time is the instant of time when the Observation, Actuation or Sampling activity was completed."@en .

schema:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:subClassOf schema:Place ;
    skos:definition "A city or town." .

schema:Continent a owl:Class ;
    rdfs:label "Continent" ;
    rdfs:subClassOf schema:Place ;
    skos:definition "One of the continents (for example, Europe or Africa)." .

schema:address a owl:DatatypeProperty ;
    rdfs:label "address" ;
    rdfs:domain schema:Place ;
    rdfs:range xsd:string ;
    skos:definition "Physical address of the item." .

schema:birthDate a owl:DatatypeProperty ;
    rdfs:label "birth date" ;
    rdfs:domain schema:Person ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date of birth." .

schema:containsPlace a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "contains place" ;
    rdfs:domain schema:Place ;
    rdfs:range schema:Place ;
    owl:inverseOf ontopfas:isContainedInPlace ;
    skos:definition "The basic containment relation between a place and another that it contains." .

schema:dateCreated a owl:AnnotationProperty .

schema:description a owl:AnnotationProperty .

schema:domainIncludes a owl:AnnotationProperty .

schema:gender a owl:DatatypeProperty ;
    rdfs:label "gender" ;
    rdfs:domain schema:Person ;
    rdfs:range xsd:string ;
    skos:definition "Gender of something, typically a Person, but possibly also fictional characters, animals, etc. While https://schema.org/Male and https://schema.org/Female may be used, text strings are also acceptable for people who are not a binary gender. The gender property can also be used in an extended sense to cover e.g. the gender of sports teams. As with the gender of individuals, we do not try to enumerate all possibilities. A mixed-gender SportsTeam can be indicated with a text value of \"Mixed\"." .

schema:homeLocation a owl:ObjectProperty ;
    rdfs:label "home location" ;
    rdfs:domain schema:Person ;
    rdfs:range schema:Place ;
    owl:inverseOf ontopfas:homeLocationOf ;
    skos:definition "A contact location for a person's residence." .

schema:license a owl:AnnotationProperty .

schema:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    skos:definition "Name of the organization." .

schema:publisher a owl:AnnotationProperty .

ontopfas: a owl:Ontology .

ontopfas:FluorinatedAndNonFluorinated a owl:Class .

ontopfas:FluorinatedPolymer a owl:Class .

ontopfas:Fluoropolymer a owl:Class .

ontopfas:IntellectualWork a owl:Class ;
    rdfs:subClassOf ontopfas:PhysicalObject .

ontopfas:MaleAndFemale a owl:Class ;
    rdfs:subClassOf schema:Person .

ontopfas:MoleculeMobility a owl:Class .

ontopfas:Object a owl:Class .

ontopfas:ObjectThing a owl:Class .

ontopfas:OtherGenders a owl:Class ;
    rdfs:subClassOf foaf:Person,
        schema:Person .

ontopfas:PFAS a owl:Class .

ontopfas:PFASPollution a owl:Class .

ontopfas:PFOA a owl:Class .

ontopfas:PFOS a owl:Class .

ontopfas:PerAndPolyfluoroalkylSubstance a owl:Class .

ontopfas:PerfluorooctanesulfonicAcid a owl:Class .

ontopfas:PerfluorooctanoicAcid a owl:Class .

ontopfas:PersonAndAnimal a owl:Class .

ontopfas:PfasAndMolecule a owl:Class .

ontopfas:Pfoa a owl:Class ;
    rdfs:label "Pfoa" ;
    rdfs:subClassOf ontopfas:LongChainPfas,
        ontopfas:Pfca ;
    skos:definition "PFOA is a specific PFCA with the formula C₇F₁₅COOH (eight carbon atoms)." .

ontopfas:Pfos a owl:Class ;
    rdfs:label "Pfos" ;
    rdfs:subClassOf ontopfas:LongChainPfas,
        ontopfas:Pfsa ;
    skos:definition "PFOS is a specific PFSA with the formula C₈F₁₇SO₃H." .

ontopfas:PolymerPfas a owl:Class ;
    rdfs:label "Polymer Pfas" ;
    rdfs:subClassOf ontopfas:Pfas ;
    skos:definition "A polymer is a substance composed of big molecules form long chains or networks." .

ontopfas:UltraShortChainPfas a owl:Class ;
    rdfs:label "Ultra short chain Pfas" ;
    rdfs:subClassOf ontopfas:ShortChainPfas ;
    skos:definition "PFAS chains with a maximum of 3 atoms of carbon." .

ontopfas:accessRights a owl:ObjectProperty ;
    rdfs:label "access rights" .

ontopfas:actiivtyInEnvironment a owl:ObjectProperty ;
    rdfs:label "activity in environment" ;
    rdfs:domain schema:Organization ;
    rdfs:range obo:ENVO_01000408 ;
    owl:inverseOf ontopfas:environmentOfActivity ;
    skos:definition "Relationship describing the environment surrounding an activity." .

ontopfas:affectedBy a owl:ObjectProperty ;
    rdfs:label "affected by" ;
    rdfs:domain schema:Place ;
    rdfs:range obo:ExO_0000022 ;
    owl:inverseOf ontopfas:affects ;
    skos:definition "Relation between a PFAS and people exposed to them." .

ontopfas:affectsPopulation a owl:ObjectProperty ;
    rdfs:domain ontopfas:ExposureRoute ;
    rdfs:range ontopfas:ExposedPopulation ;
    owl:inverseOf ontopfas:hasExposureRoute .

ontopfas:alt a owl:DatatypeProperty ;
    rdfs:label "altitude" ;
    rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    rdfs:range owl:real ;
    skos:definition "Altitude of a geographical point." .

ontopfas:casId a owl:DatatypeProperty ;
    rdfs:label "cas id" ;
    rdfs:domain ontopfas:Pfas ;
    rdfs:range xsd:string ;
    skos:definition "CAS Registry Number of the chemical substance." .

ontopfas:concernLevel a owl:DatatypeProperty ;
    rdfs:label "concern level" ;
    rdfs:domain ontopfas:Pfas ;
    rdfs:range xsd:string ;
    skos:definition "Level of concern associated with a substance (low, medium, high)." .

ontopfas:containsMeasurement a owl:ObjectProperty ;
    rdfs:label "contains measurement" ;
    rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    rdfs:range sosa:Observation ;
    owl:inverseOf ontopfas:measuredIn ;
    skos:definition "A relation between a location and a PFAS measurement." .

ontopfas:containsSubstance a owl:ObjectProperty ;
    rdfs:domain ontopfas:EnvironmentalMatrix ;
    rdfs:range ontopfas:PFASSubstance ;
    owl:inverseOf ontopfas:isContainedInProduct .

ontopfas:contributor a owl:ObjectProperty ;
    rdfs:label "This is to define the contributori." .

ontopfas:environmentOfLocation a owl:ObjectProperty ;
    rdfs:label "environment of location" ;
    rdfs:domain obo:ENVO_01000408 ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    owl:inverseOf ontopfas:locationInEnvironment ;
    skos:definition "Relation to indicate in which environment the location is present." .

ontopfas:environmentOfMobility a owl:ObjectProperty ;
    rdfs:label "environment of mobility" ;
    rdfs:domain obo:ENVO_01000408 ;
    rdfs:range ontopfas:PfasMobility ;
    owl:inverseOf ontopfas:mobilityInEnvironment ;
    skos:definition "Relation to express the level of mobility within a certain environment." .

ontopfas:environmentSubjectTo a owl:ObjectProperty ;
    rdfs:label "environment subject to" ;
    rdfs:domain obo:ENVO_01000408 ;
    rdfs:range <https://w3id.org/ocqa/regulation#Regulation> ;
    owl:inverseOf ontopfas:validInEnvironment ;
    skos:definition "Relation identifying the validity of a guideline in an environment." .

ontopfas:found a owl:ObjectProperty ;
    rdfs:label "occurs in" ;
    rdfs:domain ontopfas:PFASSubstance ;
    rdfs:range ontopfas:EnvironmentalMatrix .

ontopfas:foundIn a owl:ObjectProperty ;
    rdfs:label "occurs in" ;
    rdfs:domain ontopfas:PFASSubstance ;
    rdfs:range ontopfas:EnvironmentalMatrix .

ontopfas:functionalGroup a owl:ObjectProperty ;
    rdfs:label "functional group" ;
    rdfs:domain ontopfas:Pfas ;
    rdfs:range ontopfas:FunctionalGroup ;
    rdfs:subPropertyOf obo:BFO_0000050 ;
    owl:inverseOf ontopfas:functionalGroupOf ;
    skos:definition "Property to express the functional group of a PFAS." .

ontopfas:functionalGroupName a owl:DatatypeProperty ;
    rdfs:label "functional group name" ;
    rdfs:domain ontopfas:FunctionalGroup ;
    rdfs:range xsd:string ;
    skos:definition "Name of the functional group." .

ontopfas:handicap a owl:DatatypeProperty ;
    rdfs:label "handicap" ;
    rdfs:domain schema:Person ;
    rdfs:range xsd:string ;
    skos:definition "Indication about the presence of an handicap." .

ontopfas:hasGender a owl:ObjectProperty ;
    rdfs:label "This is to define the gender of a person." ;
    rdfs:domain schema:Person ;
    rdfs:range ontopfas:Female,
        ontopfas:Male .

ontopfas:hasRegulation a owl:ObjectProperty ;
    rdfs:label "has regulation" ;
    rdfs:domain ontopfas:PFASSubstance ;
    rdfs:range <https://w3id.org/ocqa/regulation#Regulation> .

ontopfas:hasRemediationTechnique a owl:ObjectProperty ;
    rdfs:domain ontopfas:ContaminatedSite ;
    rdfs:range ontopfas:RemediationTechnique ;
    owl:inverseOf ontopfas:monitorsContamination .

ontopfas:includesLocation a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "includes location" ;
    rdfs:domain schema:Place ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    owl:inverseOf ontopfas:locationInPlace ;
    skos:definition "A relation indicating the geographical presence of a location within an area." .

ontopfas:is a owl:ObjectProperty ;
    rdfs:label "This is to define the isA." .

ontopfas:isEther a owl:DatatypeProperty ;
    rdfs:label "is ether" ;
    rdfs:domain ontopfas:Pfas ;
    rdfs:range xsd:boolean ;
    skos:definition "Capability of a PFAS to move into the air." .

ontopfas:isHydrophilic a owl:DatatypeProperty ;
    rdfs:label "is hydrophilic" ;
    rdfs:domain ontopfas:Pfas ;
    rdfs:range xsd:boolean ;
    skos:definition "Capability of a PFAS to move into the water." .

ontopfas:isManufacturedBy a owl:ObjectProperty ;
    rdfs:domain ontopfas:PFASSubstance ;
    rdfs:range ontopfas:Manufacturer ;
    owl:inverseOf ontopfas:regulatesSubstance .

ontopfas:isRegulatedBy a owl:ObjectProperty ;
    rdfs:label "is regulated by" ;
    rdfs:domain ontopfas:PFASSubstance ;
    rdfs:range <https://w3id.org/ocqa/regulation#Regulation> .

ontopfas:isomer a owl:DatatypeProperty ;
    rdfs:label "isomer" ;
    rdfs:domain ontopfas:Pfas ;
    rdfs:range xsd:string ;
    skos:definition "Isomer of a PFAS." .

ontopfas:limit a owl:DatatypeProperty ;
    rdfs:label "limit" ;
    rdfs:domain <https://w3id.org/ocqa/regulation#Regulation> ;
    rdfs:range owl:real ;
    skos:definition "Maximum amount of PFAS in an environment." .

ontopfas:mapsLink a owl:DatatypeProperty ;
    rdfs:label "maps link" ;
    rdfs:domain schema:Organization ;
    rdfs:range xsd:string ;
    skos:definition "Google Maps link of an organisation." .

ontopfas:matrix a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "matrix" ;
    rdfs:domain sosa:Observation ;
    rdfs:range obo:ENVO_01000408 ;
    owl:inverseOf ontopfas:matrixOf ;
    skos:definition "Relation to indicate the PFAS matrix of an organization or measurement." .

ontopfas:measuredPfas a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "measured PFAS" ;
    rdfs:domain sosa:Observation ;
    rdfs:range ontopfas:Pfas ;
    owl:inverseOf ontopfas:pfasMeasuredIn ;
    skos:definition "Relation to indicate the detected PFAS." .

ontopfas:mobility a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "mobility" ;
    rdfs:domain ontopfas:Pfas ;
    rdfs:range ontopfas:PfasMobility ;
    owl:inverseOf ontopfas:mobilityOf ;
    skos:definition "Relation identifying the level of mobility of a PFAS." .

ontopfas:mobilityDegree a owl:DatatypeProperty ;
    rdfs:label "mobility degree" ;
    rdfs:domain ontopfas:PfasMobility ;
    rdfs:range xsd:int ;
    skos:definition "Degree of mobility." .

ontopfas:notValidInPlace a owl:ObjectProperty ;
    rdfs:domain <https://w3id.org/ocqa/regulation#Regulation> ;
    rdfs:range schema:Place ;
    owl:inverseOf ontopfas:validInPlace .

ontopfas:numberOfCarbons a owl:DatatypeProperty ;
    rdfs:label "number of carbons" ;
    rdfs:domain ontopfas:Pfas ;
    rdfs:range xsd:int ;
    skos:definition "Number of atoms of carbons in the molecule." .

ontopfas:ph a owl:DatatypeProperty ;
    rdfs:label "ph" ;
    rdfs:domain obo:CHEBI_24431 ;
    rdfs:range xsd:int ;
    skos:definition "Ph level of a substance." .

ontopfas:placeSubjectTo a owl:ObjectProperty ;
    rdfs:label "place subject to" ;
    rdfs:domain schema:Place ;
    rdfs:range <https://w3id.org/ocqa/regulation#Regulation> ;
    owl:inverseOf ontopfas:validInPlace ;
    skos:definition "Relation identifying the validity of a guideline in a continent." .

ontopfas:precision a owl:DatatypeProperty ;
    rdfs:label "precision" ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:string ;
    skos:definition "Value indicating possible ranges like \"<\" or \">\"." .

ontopfas:printedOn a owl:ObjectProperty ;
    rdfs:label "This is to define the printedOn." ;
    rdfs:domain ontopfas:Paper ;
    rdfs:range schema:Product .

ontopfas:restrictedBy a owl:ObjectProperty ;
    rdfs:label "restricted by" ;
    rdfs:domain ontopfas:Pfas ;
    rdfs:range <https://w3id.org/ocqa/regulation#Regulation> ;
    owl:inverseOf ontopfas:restricts .

ontopfas:sector a owl:DatatypeProperty ;
    rdfs:label "sector" ;
    rdfs:domain schema:Organization ;
    rdfs:range xsd:string ;
    skos:definition "Sector of an organisation." .

ontopfas:site a owl:DatatypeProperty ;
    rdfs:label "site" ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:string ;
    skos:definition "Site associated with the location of an observation." .

ontopfas:source a owl:ObjectProperty ;
    rdfs:label "source" .

ontopfas:sourceText a owl:DatatypeProperty ;
    rdfs:label "source text" ;
    rdfs:domain schema:Organization ;
    rdfs:range xsd:string ;
    skos:definition "Source of the text of an organisation." .

ontopfas:sourceType a owl:DatatypeProperty ;
    rdfs:label "source type" ;
    rdfs:domain schema:Organization ;
    rdfs:range xsd:string ;
    skos:definition "Source of the type of the organisation." .

ontopfas:sourceUrl a owl:DatatypeProperty ;
    rdfs:label "source url" ;
    rdfs:domain schema:Organization ;
    rdfs:range xsd:string ;
    skos:definition "URL source of an organisation." .

ontopfas:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:domain schema:Organization ;
    rdfs:range xsd:string ;
    skos:definition "Current status of the organisation." .

ontopfas:title a owl:ObjectProperty .

ontopfas:type a owl:DatatypeProperty ;
    rdfs:label "type" ;
    rdfs:domain schema:Organization ;
    rdfs:range xsd:string ;
    skos:definition "Type of an organisation." .

ontopfas:unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:decimal ;
    skos:definition "Scale of a value, e.g. 1000 for kilo or 0.001 for mili." .

ontopfas:writtenBy a owl:ObjectProperty ;
    rdfs:domain obo:ExO_0000003,
        ontopfas:Paper ;
    rdfs:range schema:Person .

mod:status a owl:AnnotationProperty .

wgs:lat a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    rdfs:range owl:real ;
    skos:definition "Latitude of a geographical point." .

wgs:long a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    rdfs:range owl:real ;
    skos:definition "Longitude of a geographical point." .

<https://www.w3.org/TR/vocab-dcat-3/#Property:resource_title> a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:domain dcat:Dataset ;
    rdfs:range xsd:string ;
    skos:definition "Technique for data collection." .

<http://purl.allotrope.org/ontologies/property#AFX_0001049> a owl:ObjectProperty ;
    rdfs:label "contained in" ;
    skos:definition "Inverse of contains." .

obo:BFO_0000050 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part of" ;
    owl:inverseOf obo:BFO_0000051 ;
    skos:definition "A core relation that holds between a part and its whole." .

obo:CHEBI_24531 a owl:Class ;
    rdfs:label "Perfluoroalkyl" ;
    rdfs:subClassOf ontopfas:Pfas .

obo:ExO_0000076 a owl:Class ;
    rdfs:label "Dose" ;
    rdfs:subClassOf obo:ExO_0000003 .

obo:ExO_0000101 a owl:Class ;
    rdfs:label "Phenotype" ;
    rdfs:subClassOf obo:ExO_0000077 .

obo:RO_0001025 a owl:ObjectProperty ;
    rdfs:label "located in" ;
    skos:definition "A relation between two independent continuants, the target and the location, in which the target is entirely within the location." .

obo:RO_0002219 a owl:ObjectProperty ;
    rdfs:label "surrounded by" ;
    owl:inverseOf obo:RO_0002219,
        obo:RO_0002221 ;
    skos:definition "x surrounded_by y if and only if (1) x is adjacent to y and for every region r that is adjacent to x, r overlaps y (2) the shared boundary between x and y occupies the majority of the outermost boundary of x." .

obo:RO_0003001 a owl:ObjectProperty ;
    rdfs:label "produced by" ;
    skos:definition "a produced_by b iff some process that occurs_in b has_output a." .

obo:SCDO_1000202 a owl:ObjectProperty ;
    rdfs:label "caused by" ;
    skos:definition "A relationship between a condition (a phenotype or disease) and an entity (e.g. environment) or condition (phenotype or disease) which could be an existing condition or an event, where the entity or second condition has a causal role for the condition being described." .

<http://semanticscience.org/resource/SIO_000655> a owl:ObjectProperty ;
    rdfs:label "transforms into" ;
    skos:definition "A transitive temporal relation in which an entity mainstains identity from one state to another." .

prov:used a owl:ObjectProperty ;
    rdfs:label "used" ;
    owl:inverseOf prov:used,
        ontopfas:usedBy ;
    skos:definition "Usage is the beginning of utilizing an entity by an activity. Before usage, the activity had not begun to utilize this entity and could not have been affected by the entity." .

foaf: a owl:Class .

foaf:Agent a owl:Class .

foaf:Organization a owl:Class .

foaf:Person a owl:Class .

foaf:PersonalProfileDocument a owl:Class .

ontopfas:ContaminatedSite a owl:Class .

ontopfas:ExposedPopulation a owl:Class .

ontopfas:Female a owl:Class ;
    rdfs:label "Female" ;
    rdfs:subClassOf schema:Person .

ontopfas:IndustrialProduct a owl:Class .

ontopfas:Male a owl:Class ;
    rdfs:label "Male" ;
    rdfs:subClassOf schema:Person .

ontopfas:Manufacturer a owl:Class .

ontopfas:MonitoringProgram a owl:Class .

ontopfas:NonPolymerPfas a owl:Class ;
    rdfs:label "Non polymer Pfas" ;
    rdfs:subClassOf ontopfas:Pfas ;
    skos:definition "A non-polymer is a substance composed of small molecules that do not form long chains or networks. These molecules are typically of uniform composition and have a relatively simple and well-defined structure." .

ontopfas:PFASContamination a owl:Class .

ontopfas:PfasPrecursor a owl:Class ;
    rdfs:label "Precursor" ;
    rdfs:subClassOf ontopfas:Pfas ;
    skos:definition "Precursor PFAS are compounds that can transform — through biological, chemical, or environmental processes — into perfluoroalkyl acids (PFAAs) such as PFOA or PFOS." .

ontopfas:Pfca a owl:Class ;
    rdfs:label "Pfca" ;
    rdfs:subClassOf ontopfas:Pfaa ;
    skos:definition "PFCAs are PFAAs that end with a carboxylic acid functional group (-COOH). Their general formula is CₙF₂ₙ₊₁COOH, where n is typically between 4 and 14." .

ontopfas:Pfsa a owl:Class ;
    rdfs:label "Pfsa" ;
    rdfs:subClassOf ontopfas:Pfaa ;
    skos:definition "PFSAs are PFAAs that end with a sulfonic acid functional group (-SO₃H). Their general formula is CₙF₂ₙ₊₁SO₃H." .

ontopfas:RemediationTechnique a owl:Class .

ontopfas:ShortChainPfas a owl:Class ;
    rdfs:label "Short chain Pfas" ;
    rdfs:subClassOf ontopfas:Pfas ;
    skos:definition "PFCA with fewer than 8 atoms of carbon or PFSA with fewer than 6 atoms of carbon." .

ontopfas:affects a owl:ObjectProperty ;
    rdfs:label "affects" ;
    rdfs:domain obo:ExO_0000022 ;
    rdfs:range schema:Place ;
    skos:definition "Relation between a PFAS and people exposed to them." .

ontopfas:environmentOfActivity a owl:ObjectProperty ;
    rdfs:label "environment of activity" ;
    rdfs:domain obo:ENVO_01000408 ;
    rdfs:range schema:Organization ;
    skos:definition "Relationship describing the environment surrounding an activity." .

ontopfas:exposureStimulusOf a owl:ObjectProperty ;
    rdfs:label "exposure stimulus of" ;
    rdfs:domain obo:ExO_0000022 ;
    rdfs:range schema:Person ;
    skos:definition "A relationship between an exposure event or process and any agent, stimulus, activity, or event that causally effects an organism and interacts with an exposure receptor during an exposure event." .

ontopfas:functionalGroupOf a owl:ObjectProperty ;
    rdfs:label "functional group of" ;
    rdfs:domain ontopfas:FunctionalGroup ;
    rdfs:range ontopfas:Pfas ;
    rdfs:subPropertyOf obo:BFO_0000051 ;
    skos:definition "Property to express the functional group of a PFAS." .

ontopfas:hasExposureRoute a owl:ObjectProperty ;
    rdfs:domain ontopfas:PFASSubstance ;
    rdfs:range ontopfas:ExposureRoute .

ontopfas:homeLocationOf a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "home location of" ;
    rdfs:domain schema:Place ;
    rdfs:range schema:Person ;
    skos:definition "A contact location for a person's residence." .

ontopfas:isContainedInPlace a owl:ObjectProperty ;
    rdfs:label "is contained in place" ;
    rdfs:domain schema:Place ;
    rdfs:range schema:Place ;
    skos:definition "Inverse of contains place." .

ontopfas:isContainedInProduct a owl:ObjectProperty ;
    rdfs:domain ontopfas:PFASSubstance ;
    rdfs:range ontopfas:IndustrialProduct .

ontopfas:locationInEnvironment a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "location in environment" ;
    rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    rdfs:range obo:ENVO_01000408 ;
    skos:definition "Relation to indicate in which environment the location is present." .

ontopfas:locationInPlace a owl:ObjectProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "location in place" ;
    rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    rdfs:range schema:Place ;
    skos:definition "Inverse of contains location." .

ontopfas:matrixOf a owl:ObjectProperty ;
    rdfs:label "matrix of" ;
    rdfs:domain obo:ENVO_01000408 ;
    rdfs:range sosa:Observation ;
    skos:definition "Relation to indicate the PFAS matrix of an organization or measurement." .

ontopfas:measuredIn a owl:ObjectProperty ;
    rdfs:label "measured in" ;
    rdfs:domain sosa:Observation ;
    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
    skos:definition "A relation between a container and measurement datum that specifies the actual amount of material in the container." .

ontopfas:mobilityInEnvironment a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "mobility in environment" ;
    rdfs:domain ontopfas:PfasMobility ;
    rdfs:range obo:ENVO_01000408 ;
    skos:definition "Relation to express the level of mobility within a certain environment." .

ontopfas:mobilityOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "mobility of" ;
    rdfs:domain ontopfas:PfasMobility ;
    rdfs:range ontopfas:Pfas ;
    skos:definition "Relation identifying the level of mobility of a PFAS." .

ontopfas:monitorsContamination a owl:ObjectProperty ;
    rdfs:domain ontopfas:MonitoringProgram ;
    rdfs:range ontopfas:PFASContamination .

ontopfas:pfasMeasuredIn a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "pfas measured in" ;
    rdfs:domain ontopfas:Pfas ;
    rdfs:range sosa:Observation ;
    skos:definition "Relation to indicate the detected PFAS." .

ontopfas:regulatesSubstance a owl:ObjectProperty ;
    rdfs:label "This is to define the regulation of a substance." ;
    rdfs:domain <https://w3id.org/ocqa/regulation#Regulation> ;
    rdfs:range ontopfas:PFASSubstance .

ontopfas:restricts a owl:ObjectProperty ;
    rdfs:label "restricts" ;
    rdfs:domain <https://w3id.org/ocqa/regulation#Regulation> ;
    rdfs:range ontopfas:Pfas ;
    skos:definition "Relation identifying the restriction of a guideline to a PFAS." .

ontopfas:source_of a owl:ObjectProperty ;
    rdfs:label "source of" ;
    rdfs:domain dcat:Dataset ;
    rdfs:range [ a owl:Class ] ;
    skos:definition "Inverse of source." .

ontopfas:stimulatedBy a owl:ObjectProperty ;
    rdfs:label "stimulated by" ;
    rdfs:domain obo:ExO_0000022 ;
    rdfs:range ontopfas:Pfas ;
    owl:inverseOf ontopfas:stimulatedBy,
        ontopfas:stimulates ;
    skos:definition "Relation indicating what is the exposed PFAS." .

ontopfas:stimulates a owl:ObjectProperty ;
    rdfs:label "stimulates" ;
    rdfs:domain ontopfas:Pfas ;
    rdfs:range obo:ExO_0000022 ;
    skos:definition "Relation indicating what is the exposed PFAS." .

ontopfas:transportedBy a owl:ObjectProperty ;
    rdfs:label "transported by" ;
    rdfs:domain ontopfas:Pfas ;
    rdfs:range obo:PCO_0000031 ;
    skos:definition "Holds between p and c when p is a transport process or transporter activity and the outcome of this p is to move c from one location to another." .

ontopfas:validInEnvironment a owl:ObjectProperty ;
    rdfs:label "valid in environment" ;
    rdfs:domain obo:ExO_0000003,
        <https://w3id.org/ocqa/regulation#Regulation> ;
    rdfs:range obo:ENVO_01000408 ;
    skos:definition "Relation identifying the validity of a guideline in an environment." .

<urn:absolute:ontopfas#Presumptive> a owl:Class ;
    rdfs:label "Presumptive" ;
    rdfs:subClassOf sosa:Observation ;
    skos:definition "Presumptive PFAS observation." .

obo:BFO_0000051 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has part" ;
    skos:definition "A core relation that holds between a part and its whole." .

obo:PCO_0000031 a owl:Class ;
    rdfs:label "Organismal entity"@en ;
    rdfs:subClassOf obo:CHEBI_24431 .

obo:RO_0002221 a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "surrounds" ;
    owl:inverseOf obo:RO_0002221 ;
    skos:definition "inverse of surrounded by." .

schema:Product a owl:Class ;
    rdfs:label "Product" ;
    skos:definition "Any offered product or service. For example: a pair of shoes; a concert ticket; the rental of a car; a haircut; or an episode of a TV show streamed online."@en .

ontopfas:ExposureRoute a owl:Class .

ontopfas:LongChainPfas a owl:Class ;
    rdfs:label "Long chain Pfas" ;
    rdfs:subClassOf ontopfas:Pfas ;
    skos:definition "PFCA with more than 7 atoms of carbon or PFSA with more than 5 atoms of carbon." .

ontopfas:Paper a owl:Class ;
    rdfs:subClassOf ontopfas:PhysicalObject .

ontopfas:Pfaa a owl:Class ;
    rdfs:label "Pfaa" ;
    rdfs:subClassOf obo:CHEBI_24531,
        ontopfas:NonPolymerPfas ;
    skos:definition "Perfluoroalkyl acids (PFAAs) are a subclass of PFAS that have a fully fluorinated carbon chain (no hydrogen atoms attached to the carbon backbone) ending with a functional acid group — either a carboxylic acid (-COOH) or a sulfonic acid (-SO₃H) group." .

ontopfas:PhysicalObject a owl:Class ;
    rdfs:subClassOf dcat:Dataset .

ontopfas:usedBy a owl:ObjectProperty ;
    rdfs:label "used by" ;
    rdfs:domain schema:Organization,
        schema:Product ;
    rdfs:range schema:Organization ;
    owl:inverseOf ontopfas:usedBy ;
    skos:definition "Inverse of used." .

ontopfas:validInPlace a owl:ObjectProperty ;
    rdfs:label "valid in place" ;
    rdfs:domain obo:ENVO_01000408,
        <https://w3id.org/ocqa/regulation#Regulation> ;
    rdfs:range schema:Place .

ontopfas:EnvironmentalMatrix a owl:Class .

obo:CHEBI_24431 a owl:Class ;
    rdfs:label "Chemical entity" ;
    rdfs:subClassOf obo:PCO_0000031,
        ontopfas:FunctionalGroup .

obo:ExO_0000077 a owl:Class ;
    rdfs:label "Biological response" ;
    rdfs:subClassOf obo:ExO_0000003 .

dcat:Dataset a owl:Class ;
    rdfs:label "قائمة بيانات"@ar,
        "Datová sada"@cs,
        "Datasæt"@da,
        "Σύνολο Δεδομένων"@el,
        "Dataset"@en,
        "Conjunto de datos"@es,
        "Jeu de données"@fr,
        "Dataset"@it,
        "データセット"@ja ;
    skos:definition """
قائمة بيانات منشورة أو مجموعة من قبل مصدر ما و متاح الوصول إليها أو تحميلها
"""@ar,
        """
Kolekce dat poskytovaná či řízená jedním zdrojem, která je k dispozici pro přístup či stažení v jednom či více formátech.
"""@cs,
        """
En samling a data, udgivet eller udvalgt og arrangeret af en enkelt kilde og som der er adgang til i en eller flere repræsentationer.
"""@da,
        """
Μία συλλογή από δεδομένα, δημοσιευμένη ή επιμελημένη από μία και μόνο πηγή, διαθέσιμη δε προς πρόσβαση ή μεταφόρτωση σε μία ή περισσότερες μορφές.
"""@el,
        """
A collection of data, published or curated by a single source, and available for access or download in one or more representations.
"""@en,
        """
Una colección de datos, publicados o conservados por una única fuente, y disponibles para ser accedidos o descargados en uno o más formatos.
"""@es,
        """
Une collection de données, publiée ou élaborée par une seule source, et disponible pour accès ou téléchargement dans un ou plusieurs formats.
"""@fr,
        """
Raccolta di dati, pubblicati o curati da un'unica fonte, disponibili per l'accesso o il download in uno o più formati.
"""@it,
        """
1つのエージェントによって公開またはキュレートされ、1つ以上の形式でアクセスまたはダウンロードできるデータの集合。
"""@ja .

ontopfas:FunctionalGroup a owl:Class ;
    rdfs:label "Functional group" ;
    rdfs:subClassOf obo:CHEBI_24431 ;
    skos:definition "Functional group of the PFAS, responsible for the reactive part." .

obo:ExO_0000003 a owl:Class ;
    rdfs:label "Exposure outcome" ;
    rdfs:subClassOf obo:ExO_0000076,
        obo:ExO_0000077 .

obo:ExO_0000022 a owl:Class ;
    rdfs:label "Exposure stimulus" .

ontopfas:PfasMobility a owl:Class ;
    rdfs:label "Pfas mobility" ;
    skos:definition "Degree of mobility associated with the PFAS." .

<http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> a owl:Class ;
    rdfs:label "Location" ;
    skos:definition "Anything with spatial extent, i.e. size, shape, or position. e.g. people, places, bowling balls, as well as abstract areas like cubes." .

ontopfas:PFASSubstance a owl:Class .

obo:ENVO_01000408 a owl:Class ;
    rdfs:label "Environmental zone" ;
    skos:definition "A site which has its extent determined by the presence or influence of one or more components of an environmental system or the processes occurring therein." .

schema:Organization a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:subClassOf foaf:Organization ;
    skos:definition "An organization such as a school, NGO, corporation, club, etc."@en .

<https://w3id.org/ocqa/regulation#Regulation> a owl:Class ;
    rdfs:label "Regulation" ;
    rdfs:subClassOf foaf:,
        foaf:PersonalProfileDocument ;
    skos:definition "Regulation about the presence of the PFAS in the environments." .

sosa:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:subClassOf <urn:absolute:ontopfas#Presumptive> ;
    skos:definition "Activity of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with."@en .

schema:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf foaf:Agent ;
    skos:definition "A person (alive, dead, undead, or fictional)." .

schema:Place a owl:Class ;
    rdfs:label "Place" ;
    skos:definition "Physical place (city, region, country, continent)." .

ontopfas:Pfas a owl:Class ;
    rdfs:label "Pfas" ;
    rdfs:subClassOf obo:CHEBI_24431 ;
    skos:definition "Per- and poly- fluoroalkyl substance." .

