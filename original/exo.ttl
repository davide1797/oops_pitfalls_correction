#################################################################
#    Object Properties
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000050
obo:BFO_0000050 rdf:type owl:ObjectProperty ;
                obo:IAO_0000115 "For continuants: C part_of C' if and only if: given any c that instantiates C at a time t, there is some c' such that c' instantiates C' at time t, and c *part_of* c' at t. For processes: P part_of P' if and only if: given any p that instantiates P at a time t, there is some p' such that p' instantiates P' at time t, and p *part_of* p' at t. (Here *part_of* is the instance-level part-relation.)" ;
                oboInOwl:hasDbXref "BFO:0000050" ;
                oboInOwl:hasOBONamespace "source" ;
                oboInOwl:id "part_of" ;
                oboInOwl:shorthand "part_of" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:BFO_0000050 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "For continuants: C part_of C' if and only if: given any c that instantiates C at a time t, there is some c' such that c' instantiates C' at time t, and c *part_of* c' at t. For processes: P part_of P' if and only if: given any p that instantiates P at a time t, there is some p' such that p' instantiates P' at time t, and p *part_of* p' at t. (Here *part_of* is the instance-level part-relation.)" ;
   oboInOwl:hasDbXref "PMID:15892874"
 ] .


###  http://purl.obolibrary.org/obo/BFO_0000051
obo:BFO_0000051 rdf:type owl:ObjectProperty ,
                         owl:TransitiveProperty ;
                oboInOwl:hasDbXref "BFO:0000051" ;
                oboInOwl:hasOBONamespace "source" ;
                oboInOwl:id "has_part" ;
                oboInOwl:shorthand "has_part" ;
                rdfs:label "has_part" .


###  http://purl.obolibrary.org/obo/RO_0002434
