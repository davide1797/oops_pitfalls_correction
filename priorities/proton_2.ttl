@prefix : <http://www.ontotext.com/proton/protontop#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.ontotext.com/proton/protontop> rdfs:label "Proton Ontology" .

:Abstract rdfs:label "Abstract"@en .

:Event rdfs:label "Event"@en .

:GeneralTerm rdfs:label "General Term"@en .

:Number rdfs:label "Number"@en .

:Situation rdfs:label "Situation"@en .

:TimeInterval rdfs:label "Time Interval"@en .

:controls rdfs:label "Controls"@en .

:derivedFromSource rdfs:label "Derived from Source"@en ;
    rdfs:domain :InformationResource ;
    rdfs:range :InformationResource .

:description rdfs:label "Description"@en ;
    rdfs:domain :Entity .

:documentAbstract rdfs:label "Document Abstract"@en ;
    rdfs:domain :Document .

:documentAuthor rdfs:label "Document Author"@en ;
    rdfs:range :Agent .

:documentSubTitle rdfs:label "Document Subtitle"@en ;
    rdfs:domain :Document .

:doingBusinessAs rdfs:label "Doing Business as"@en ;
    rdfs:domain :Organization .

:endTime rdfs:label "End Time"@en ;
    rdfs:domain :Happening .

:establishedIn rdfs:label "Established in"@en ;
    rdfs:domain :Organization .

:establishmentDate rdfs:label "Establishment Date"@en ;
    rdfs:domain :Organization .

:firstName rdfs:label "First Name"@en ;
    rdfs:domain :Person .

:givenName rdfs:label "Given Name"@en ;
    rdfs:domain :Person .

:hasChild rdfs:label "has Child"@en ;
    owl:inverseOf :hasParent .

:hasContactInfo rdfs:label "has Contact Info"@en ;
    rdfs:domain :Object ;
    rdfs:range :ContactInformation .

:hasContributor rdfs:label "has Contributor"@en ;
    rdfs:domain :InformationResource ;
    rdfs:range :Agent .

:hasCreator rdfs:label "has Creator"@en .

:hasDate rdfs:label "has Date"@en ;
    rdfs:domain :InformationResource .

:hasEmployee rdfs:label "has Employee"@en ;
    rdfs:range :Person .

:hasLeader rdfs:label "has Leader"@en ;
    rdfs:range :Person .

:hasMember rdfs:label "has Member"@en ;
    rdfs:domain :Group ;
    rdfs:range :Agent .

:hasOldName rdfs:label "has Old Name"@en .

:hasParticipant rdfs:label "Participant in a Happening"@en ;
    rdfs:domain :Happening ;
    rdfs:range :Agent ;
    owl:inverseOf :involvedIn .

:hasParticipatingEntity rdfs:label "Entity Participating in a Happening"@en ;
    rdfs:domain :Happening ;
    rdfs:range :Entity ;
    owl:inverseOf :involvedEntityIn .

:hasPosition rdfs:label "has Position"@en ;
    rdfs:domain :Person ;
    rdfs:range :JobPosition ;
    owl:inverseOf :holder .

:hasRelative rdfs:label "has Relative"@en ;
    rdfs:domain :Person ;
    rdfs:range :Person .

:hasSibling rdfs:label "has Sibling"@en .

:hasSocialPosition rdfs:label "has Social Position"@en ;
    rdfs:domain :Person ;
    rdfs:range :SocialPosition ;
    owl:inverseOf :socialPositionHolder .

:hasSpouse rdfs:label "has Spouse"@en .

:hasSubject rdfs:label "has Subject"@en ;
    rdfs:domain :InformationResource ;
    rdfs:range :Topic .

:heldFrom rdfs:label "Held from"@en ;
    rdfs:domain :JobPosition .

:heldTo rdfs:label "Held to"@en ;
    rdfs:domain :JobPosition .

:inLanguage rdfs:label "in Language"@en ;
    rdfs:domain :InformationResource ;
    rdfs:range :Language .

:informationResourceCoverage rdfs:label "Information Resource Coverage"@en ;
    rdfs:domain :InformationResource .

:informationResourceIdentifier rdfs:label "Information Resource Identifier"@en ;
    rdfs:domain :InformationResource .

:informationResourceRights rdfs:label "Information Resource Rights"@en ;
    rdfs:domain :InformationResource .

:isBossOf rdfs:label "is Boss of"@en ;
    rdfs:domain :Person ;
    rdfs:range :Person .

:isLegalEntity rdfs:label "is Legal Entity"@en ;
    rdfs:domain :Agent .

:isOwnedBy rdfs:label "is Owned by"@en ;
    rdfs:domain :Object ;
    rdfs:range :Agent .

:laconicDescription rdfs:label "Laconic Description"@en .

:lastName rdfs:label "Last Name"@en ;
    rdfs:domain :Person .

:latitude rdfs:label "Latitude"@en ;
    rdfs:domain :Location .

:locatedIn rdfs:label "Located in"@en ;
    rdfs:domain :Entity ;
    rdfs:range :Location .

:longitude rdfs:label "Longitude"@en ;
    rdfs:domain :Location .

:mainLabel rdfs:label "Main Label"@en ;
    rdfs:domain :Entity ;
    rdfs:range rdfs:Literal .

:name rdfs:label "Name of any kind"@en ;
    rdfs:domain :Entity ;
    rdfs:range rdfs:Literal .

:nimaGNSDesignator rdfs:label "NIMA GNS Designator"@en ;
    rdfs:domain :Location .

:nimaGNSUniqueFeatureIndentifier rdfs:label "NIMA GNS Unique Feature Identifier"@en ;
    rdfs:domain :Location .

:numberOfEmployees rdfs:label "Number of Employees"@en ;
    rdfs:domain :Organization .

:operatedBy rdfs:label "Operated by"@en ;
    rdfs:domain :Service ;
    rdfs:range :Agent .

:owns rdfs:label "Owns"@en .

:parentOrganizationOf rdfs:label "Parent Organization of"@en ;
    rdfs:domain :Organization ;
    rdfs:range :Organization ;
    owl:inverseOf :subsidiaryOrganizationOf .

:partOf rdfs:label "Part of"@en ;
    rdfs:domain :Entity ;
    rdfs:range :Entity .

:partiallyControls rdfs:label "Partially Controls"@en ;
    rdfs:domain :Agent ;
    rdfs:range :Object .

:partiallyOwns rdfs:label "Partially Owns"@en .

:populationCount rdfs:label "Population Count"@en ;
    rdfs:domain :Location .

:producedBy rdfs:label "Produced by"@en ;
    rdfs:domain :ProductModel ;
    rdfs:range :Agent .

:registeredIn rdfs:label "Registered in"@en ;
    rdfs:domain :Organization .

:resourceFormat rdfs:label "Resource Format"@en ;
    rdfs:domain :InformationResource .

:resourceType rdfs:label "Resource Type"@en ;
    rdfs:domain :InformationResource .

:roleHolder rdfs:label "Role Holder"@en ;
    rdfs:domain :Role ;
    rdfs:range :Entity .

:roleIn rdfs:label "Role in"@en ;
    rdfs:domain :Role ;
    rdfs:range :Happening .

:startTime rdfs:label "Start Time"@en ;
    rdfs:domain :Happening .

:statedBy rdfs:label "Stated by"@en ;
    rdfs:domain :Statement ;
    rdfs:range :Agent .

:subRegionOf rdfs:label "Subregion of"@en ;
    rdfs:domain :Location .

:subTopicOf rdfs:label "Subtopic of"@en ;
    rdfs:domain :Topic ;
    rdfs:range :Topic .

:systemPrimitive rdfs:label "System Primitive"@en .

:title rdfs:label "Title"@en ;
    rdfs:domain :InformationResource .

:transitiveOver rdfs:label "Transitive over"@en .

:validFrom rdfs:label "Valid from"@en ;
    rdfs:domain :Statement .

:validUntil rdfs:label "Valid until"@en ;
    rdfs:domain :Statement .

:withinOrganization rdfs:label "within Organization"@en ;
    rdfs:domain :JobPosition ;
    rdfs:range :Organization .

:ContactInformation rdfs:label "Contact Information"@en .

:Group rdfs:label "Group"@en .

:Language rdfs:label "Language"@en .

:ProductModel rdfs:label "Product Model"@en .

:Service rdfs:label "Service"@en .

:hasParent rdfs:label "has Parent"@en .

:holder rdfs:label "Holder"@en ;
    rdfs:domain :JobPosition ;
    rdfs:range :Person .

:involvedEntityIn rdfs:label "Entity Involved in"@en ;
    rdfs:domain :Entity ;
    rdfs:range :Happening .

:involvedIn rdfs:label "Involved in"@en ;
    rdfs:domain :Agent,
        :Entity ;
    rdfs:range :Happening .

:socialPositionHolder rdfs:label "Social Position Holder"@en ;
    rdfs:domain :SocialPosition ;
    rdfs:range :Person .

:subsidiaryOrganizationOf rdfs:label "Subsidiary Organization of"@en ;
    rdfs:domain :Organization ;
    rdfs:range :Organization .

:Document rdfs:label "Document"@en .

:Role rdfs:label "Role"@en .

:SocialPosition rdfs:label "Social Position"@en .

:Object rdfs:label "Object"@en .

