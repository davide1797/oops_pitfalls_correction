 ] .


###  http://purl.obolibrary.org/obo/ExO_0000012
obo:ExO_0000012 rdf:type owl:Class ;
                rdfs:subClassOf obo:ExO_0000007 ;
                obo:IAO_0000115 "An ecological perturbation that results from the deterioration of  an ecological or environmental area that is inhabited by a particular species of animal, plant or other type of organism." ;
                oboInOwl:created_by "cmattin" ;
                oboInOwl:creation_date "2011-01-10T04:18:53Z" ;
                oboInOwl:hasOBONamespace "exposure_stressor" ;
                oboInOwl:id "ExO:0000012" ;
                rdfs:label "habitat degradation" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:ExO_0000012 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "An ecological perturbation that results from the deterioration of  an ecological or environmental area that is inhabited by a particular species of animal, plant or other type of organism." ;
   oboInOwl:hasDbXref "GOC:hjd"
 ] .


###  http://purl.obolibrary.org/obo/ExO_0000013
obo:ExO_0000013 rdf:type owl:Class ;
                rdfs:subClassOf obo:ExO_0000007 ;
                obo:IAO_0000115 "An ecological perturbation that is acidic water, usually pH 2.5 to 4.5, which poisons the ecosystem and adversely affects plants, fishes, and mammals. It is caused by industrial pollutants, mainly sulfur oxides and nitrogen oxides, emitted into the atmosphere and returning to earth in the form of acidic rain water." ;
                oboInOwl:created_by "cmattin" ;
                oboInOwl:creation_date "2011-01-10T04:19:11Z" ;
                oboInOwl:hasOBONamespace "exposure_stressor" ;
                oboInOwl:id "ExO:0000013" ;
                rdfs:label "acid rain" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:ExO_0000013 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "An ecological perturbation that is acidic water, usually pH 2.5 to 4.5, which poisons the ecosystem and adversely affects plants, fishes, and mammals. It is caused by industrial pollutants, mainly sulfur oxides and nitrogen oxides, emitted into the atmosphere and returning to earth in the form of acidic rain water." ;
   oboInOwl:hasDbXref "MSH:D015258" ,
                      "UMLS:C0001111"
 ] .


###  http://purl.obolibrary.org/obo/ExO_0000014
obo:ExO_0000014 rdf:type owl:Class ;
                rdfs:subClassOf obo:ExO_0000007 ;
                obo:IAO_0000115 "An ecological pertubation that is any significant change in measures of climate (such as temperature, precipitation, or wind) lasting for an extended period (decades or longer). It may result from natural factors such as changes in the sun's intensity, natural processes within the climate system such as changes in ocean circulation, or human activities." ;
                oboInOwl:created_by "cmattin" ;
                oboInOwl:creation_date "2011-01-10T04:19:26Z" ;
                oboInOwl:hasOBONamespace "exposure_stressor" ;
                oboInOwl:id "ExO:0000014" ;
                rdfs:label "climate change" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:ExO_0000014 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "An ecological pertubation that is any significant change in measures of climate (such as temperature, precipitation, or wind) lasting for an extended period (decades or longer). It may result from natural factors such as changes in the sun's intensity, natural processes within the climate system such as changes in ocean circulation, or human activities." ;
   oboInOwl:hasDbXref "MSH:D057231" ,
                      "UMLS:C2718051"
 ] .


###  http://purl.obolibrary.org/obo/ExO_0000015
obo:ExO_0000015 rdf:type owl:Class ;
                rdfs:subClassOf obo:ExO_0000009 ;
                obo:IAO_0000115 "A psychosocial agent that is a situation in which the level of living of an individual, family, or group is below the standard of the community. It is often related to a specific income level." ;
                oboInOwl:created_by "cmattin" ;
                oboInOwl:creation_date "2011-01-10T04:19:54Z" ;
                oboInOwl:hasOBONamespace "exposure_stressor" ;
                oboInOwl:hasRelatedSynonym "indigency" ;
                oboInOwl:id "ExO:0000015" ;
                rdfs:label "poverty" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:ExO_0000015 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A psychosocial agent that is a situation in which the level of living of an individual, family, or group is below the standard of the community. It is often related to a specific income level." ;
