<http://purl.obolibrary.org/obo/exo.owl> rdf:type owl:Ontology ;
                                          owl:versionIRI <http://purl.obolibrary.org/obo/exo/releases/2022-06-29/exo.owl> ;
                                          dc:description "ExO is intended to bridge the gap between exposure science and diverse environmental health disciplines including toxicology, epidemiology, disease surveillance, and epigenetics." ;
                                          dc:title "Exposure ontology (ExO)" ;
                                          terms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                          oboInOwl:default-namespace "source" ;
                                          oboInOwl:hasOBOFormatVersion "1.2" ;
                                          owl:versionInfo "2022-06-29" .

