<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.mistea.supagro.inra.fr/ontologies/2016/v1/afeo"
     xml:base="http://www.mistea.supagro.inra.fr/ontologies/2016/v1/afeo"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:oae="http://www.mistea.supagro.inra.fr/ontologies/2015/oae"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:ofpe="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v1/afeo">
        <owl:versionIRI rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2016/v1/afeo"/>
        <owl:imports rdf:resource="http://opensilex.org/vocabulary/2016/v4/aeo.owl"/>
        <owl:imports rdf:resource="http://opensilex.org/vocabulary/2016/v4/ofpe.owl"/>
        <dc:creator xml:lang="en">Aunur-Rofiq MULJARTO,  Jean-Michel SALMON, Brigitte CHARNOMORDIC, Patrice BUCH, Anne TIREAU, Pascal NEVEU</dc:creator>
        <dc:description xml:lang="en">The Agri-Food Experiment Ontology (AFEO), a new ontology network was developed based on two existing ontology resources, i.e., OAE (Ontology for Agriculture Experiment) and OFPE (Ontology for Food Processing Experiment).</dc:description>
        <dc:language xml:lang="en">http://www.lexvo.org/page/iso639-3/eng</dc:language>
        <dc:publisher xml:lang="en">INRA MISTEA, SPO, IATE
Copyright © - INRA - 2014 - 2022</dc:publisher>
        <dc:rights xml:lang="en">http://creativecommons.org/licenses/by/4.0/legalcode</dc:rights>
        <dc:title xml:lang="en">Agri-Food Experiment Ontology
(AFEO),</dc:title>
        <rdfs:comment xml:lang="en">INRA MISTEA, SPO, IATE
Copyright © - INRA - 2014 - 2022
The Ontology for Agricultural Experiments is licensed by CC 4.0 (http://creativecommons.org/licenses/by/4.0/legalcode)</rdfs:comment>
        <owl:versionInfo xml:lang="en">4.2 May 2022
change import</owl:versionInfo>
    </owl:Ontology>
    


