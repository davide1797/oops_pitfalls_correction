obo:ExO_0000011 rdf:type owl:Class ;
                rdfs:subClassOf obo:ExO_0000000 ;
                obo:IAO_0000115 "A mechanical agent applied to biological systems, such as humans, animals, plants, organs, and cells" ;
                oboInOwl:created_by "cmattin" ;
                oboInOwl:creation_date "2011-01-10T04:17:29Z" ;
                oboInOwl:hasOBONamespace "exposure_stressor" ;
                oboInOwl:id "ExO:0000011" ;
                rdfs:label "biomechanical agent" .

