<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo"
     xml:base="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo">
        <owl:versionIRI rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo"/>
        <owl:imports rdf:resource="http://purl.org/NET/dc_owl2dl/terms"/>
        <dc:contributor>Alexandre MAIRIN, Jonathan MINEAU, Isabelle Nembrot, Aunur-Rofiq MULJARTO</dc:contributor>
        <dc:creator>Anne TIREAU, Pascal NEVEU</dc:creator>
        <dc:description xml:lang="en">AEO is an ontology aimed to represent objects related to agricultural practices.</dc:description>
        <dc:language>http://www.lexvo.org/page/iso639-3/eng</dc:language>
        <dc:rights>The Agricultural Experiments Ontology is licensed by CC 4.0 (http://creativecommons.org/licenses/by/4.0/legalcode)</dc:rights>
        <dc:title xml:lang="en">Agricultural Experiments Ontology</dc:title>
        <terms:hasVersion xml:lang="en">31st May 2022</terms:hasVersion>
        <terms:publisher>INRA MISTEA
Copyright © - INRA - 2014 - 2022</terms:publisher>
        <rdfs:comment xml:lang="en">Agricultural Experiments Ontology</rdfs:comment>
        <rdfs:comment>Authors : Anne TIREAU, Alexandre MAIRIN, Jonathan MINEAU, Isabelle Nembrot, Aunur-Rofiq MULJARTO, Pascal NEVEU</rdfs:comment>
        <rdfs:comment>INRA MISTEA
Copyright © - INRA - 2014 - 2022
The Agricultural Experiments Ontology is licensed by CC 4.0 (http://creativecommons.org/licenses/by/4.0/legalcode)</rdfs:comment>
        <owl:versionInfo>Version 3.3.1 created by UMR MISTEA</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
