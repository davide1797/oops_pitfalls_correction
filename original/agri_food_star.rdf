    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/language -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/language"/>
    


    <!-- http://purl.org/dc/elements/1.1/publisher -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/publisher"/>
    


    <!-- http://purl.org/dc/elements/1.1/rights -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/rights"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasPlant -->

    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasPlant">
        <owl:inverseOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#hasObservedObject"/>
    </rdf:Description>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2016/v1/afeo#is -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v1/afeo#is"/>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#before -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#before">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/oae#Harvesting"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#Operation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#hasAttribute -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#hasAttribute">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriActivity"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriEntity"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#Operation"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:label xml:lang="en">has attribute</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#hasInput -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#hasInput">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/oae#Harvesting"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#Operation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#hasMethod -->

    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#hasMethod">
        <owl:inverseOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#isOrganizationOf"/>
    </rdf:Description>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#hasObservedObject -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#hasObservedObject">
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriActivity"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriEntity"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#Operation"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#hasOutput -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#hasOutput">
        <owl:inverseOf rdf:resource="http://www.w3.org/2006/time#intervalDisjoint"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/oae#Harvesting"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#Operation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#isInputOf -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#isInputOf">
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/oae#Harvesting"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#Operation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#isObservedObjectOf -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#isObservedObjectOf">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriActivity"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriEntity"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#Operation"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#isOutputOf -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#isOutputOf">
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/oae#Harvesting"/>
                    <rdf:Description rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2016/v4/ontofp#Operation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#before -->

    <rdf:Description rdf:about="http://www.w3.org/2006/time#before">
        <owl:inverseOf rdf:resource="http://www.w3.org/2006/time#before"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/2006/time#hasTemporalDuration -->

    <rdf:Description rdf:about="http://www.w3.org/2006/time#hasTemporalDuration">
        <owl:inverseOf rdf:resource="http://www.w3.org/2006/time#inside"/>
    </rdf:Description>
    


