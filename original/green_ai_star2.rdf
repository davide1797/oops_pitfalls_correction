    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/contributor"/>
    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/language -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/language"/>
    


    <!-- http://purl.org/dc/elements/1.1/rights -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/rights"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/hasVersion -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/hasVersion"/>
    


    <!-- http://purl.org/dc/terms/publisher -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#appliedTo -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#appliedTo">
        <owl:inverseOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#applies"/>
        <rdfs:domain rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriActivity"/>
        <rdfs:range rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriEntity"/>
        <rdfs:comment xml:lang="en">semantic relation between classes under AgriActivity and some classes under Agrientity. This relation represents that an instance of AgriActivity is applied to an instance of AgriEntity. For instance, an instance of Fertilizing is applied to an instance of Plot or SubPlot</rdfs:comment>
        <rdfs:label xml:lang="en">applied to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#applies -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#applies">
        <rdfs:comment xml:lang="en">semantic relation between classes under AgriActivity and some classes under Agrientity. This relation represents that an instance of AgriActivity is applied to an instance of AgriEntity. For instance, an instance of Fertilizing is applied to an instance of Plot or SubPlot</rdfs:comment>
        <rdfs:label xml:lang="en">applies</rdfs:label>
        <skos:definition xml:lang="en">semantic relation between classes under AgriActivity and some classes under Agrientity. This relation represents that an instance of AgriActivity is applied to an instance of AgriEntity. For instance, an instance of Fertilizing is applied to an instance of Plot or SubPlot</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasLocation -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasLocation">
        <owl:inverseOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#locationOf"/>
        <rdfs:domain rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriExperiment"/>
        <rdfs:range rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Area"/>
        <rdfs:range rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#InterRow"/>
        <rdfs:range rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Row"/>
        <rdfs:comment xml:lang="en">semantic relation between AgriExperiment and CultivationArea</rdfs:comment>
        <rdfs:label xml:lang="en">has location</rdfs:label>
        <skos:definition xml:lang="en">semantic relation between AgriExperiment and CultivationArea</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasPart -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasPart">
        <owl:inverseOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#partOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment xml:lang="en">semantic relation between Plant class and Organ class</rdfs:comment>
        <rdfs:label xml:lang="en">has part</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://www.w3.org/2001/sw/BestPractices/OEP/SimplePartWhole/</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasPart_directly -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasPart_directly">
        <rdfs:subPropertyOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasPart"/>
        <owl:inverseOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#partOf_directly"/>
        <rdfs:label xml:lang="en">has part directly</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasPlant -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasPlant">
        <rdfs:domain rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Area"/>
        <rdfs:domain rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#InterRow"/>
        <rdfs:domain rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Row"/>
        <rdfs:range rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Plant"/>
        <rdfs:label xml:lang="en">This is to identify the has plant relationship</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasSpecies -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasSpecies">
        <rdfs:domain rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Plant"/>
        <rdfs:range rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Species"/>
        <rdfs:label xml:lang="en">has species</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasVariety -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#hasVariety">
        <rdfs:domain rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Plant"/>
        <rdfs:label xml:lang="en">has variety</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#included -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#included">
        <owl:inverseOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#includes"/>
        <rdfs:comment xml:lang="en">semantic relation among cultivation locations (FarmArea, CultivationArea and its subclasses)</rdfs:comment>
        <rdfs:label xml:lang="en">included</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#includes -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#includes">
        <rdfs:comment xml:lang="en">semantic relation among cultivation locations (FarmArea, CultivationArea and its subclasses)</rdfs:comment>
        <rdfs:label xml:lang="en">includes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#involvedIn -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#involvedIn">
        <rdfs:comment xml:lang="en">semantic relation between AgriExperiment and AgriActivity as well as AgriEntity. An instance of AgriExperiment involves different instances of AgriActivity and AgriEntity</rdfs:comment>
        <rdfs:label xml:lang="en">involved in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#involves -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#involves">
        <rdfs:comment xml:lang="en">semantic relation between AgriExperiment and AgriActivity as well as AgriEntity. An instance of AgriExperiment involves different instances of AgriActivity and AgriEntity</rdfs:comment>
        <rdfs:label xml:lang="en">involves</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#locationOf -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#locationOf">
        <rdfs:comment xml:lang="en">semantic relation between AgriExperiment and CultivationArea</rdfs:comment>
        <rdfs:label xml:lang="en">location of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#partOf -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#partOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Organ"/>
        <rdfs:range rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Organ"/>
        <rdfs:range rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Plant"/>
        <rdfs:comment xml:lang="en">semantic relation between Plant class and Organ class</rdfs:comment>
        <rdfs:label xml:lang="en">part of</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://www.w3.org/2001/sw/BestPractices/OEP/SimplePartWhole/</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#partOf_directly -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#partOf_directly">
        <rdfs:subPropertyOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#partOf"/>
        <rdfs:label xml:lang="en">part of directly</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#requiredBy -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#requiredBy">
        <owl:inverseOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#requires"/>
        <rdfs:domain rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#DiseasesControlling"/>
        <rdfs:domain rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Fertilizing"/>
        <rdfs:domain rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Irrigation"/>
        <rdfs:range rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriInput"/>
        <rdfs:range rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#PhytoSanitaryAgriInput"/>
        <rdfs:comment xml:lang="en">semantic relation between some classes under AgriActivity, i.e., DiseaseContolling, Fertilizing and Irrigation) and respective classes under AgriEntity (i.e., Phytosanitary, Fertilizer, Water)</rdfs:comment>
        <rdfs:label xml:lang="en">required by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#requires -->

    <owl:ObjectProperty rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#requires">
        <rdfs:comment xml:lang="en">semantic relation between some classes under AgriActivity, i.e., DiseaseContolling, Fertilizing and Irrigation) and respective classes under AgriEntity (i.e., Phytosanitary, Fertilizer, Water)</rdfs:comment>
        <rdfs:label xml:lang="en">requires</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriActivity -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriActivity">
        <rdfs:comment xml:lang="en">represents common activities ou operations performed during experiments</rdfs:comment>
        <rdfs:label xml:lang="en">agricultural activity</rdfs:label>
        <skos:definition xml:lang="en">represents common activities ou operations performed during experiments</skos:definition>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriEntity -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriEntity">
        <rdfs:comment xml:lang="en">represents objects that are observed and followed during field experiments</rdfs:comment>
        <rdfs:label xml:lang="en">agricultural entity</rdfs:label>
        <skos:definition xml:lang="en">represents objects that are observed and followed during field experiments</skos:definition>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriExperiment -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriExperiment">
        <rdfs:comment xml:lang="en">represents experiments carried out by researchers</rdfs:comment>
        <rdfs:label xml:lang="en">agricultural experiment</rdfs:label>
        <skos:definition xml:lang="en">represents experiments carried out by researchers</skos:definition>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriInput -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriInput">
        <rdfs:label xml:lang="en">agricultural input</rdfs:label>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Area -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Area">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriEntity"/>
        <rdfs:comment>zone spatiale : calcaire, AOC, pentue, etc.
cf Dolce</rdfs:comment>
        <rdfs:label xml:lang="en">land area</rdfs:label>
        <rdfs:seeAlso>spécialisation de http://aims.fao.org/aos/agrovoc/c_330588</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Berry -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Berry">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Organ"/>
        <rdfs:label xml:lang="fr">baie</rdfs:label>
        <rdfs:label xml:lang="en">berry</rdfs:label>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Bunch -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Bunch">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Organ"/>
        <rdfs:label xml:lang="fr">grape</rdfs:label>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#CultivatedLand -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#CultivatedLand">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Area"/>
        <rdfs:label xml:lang="fr">Terre cultivée</rdfs:label>
        <rdfs:label xml:lang="en">cultivated land</rdfs:label>
        <rdfs:seeAlso>http://aims.fao.org/aos/agrovoc/c_16212</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#DiseasesControlling -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#DiseasesControlling">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriActivity"/>
        <rdfs:label xml:lang="en">diseases controlling</rdfs:label>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#FarmArea -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#FarmArea">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Area"/>
        <rdfs:comment xml:lang="fr">batiment, etrrain, grange, infrastructure, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">farm area</rdfs:label>
        <rdfs:seeAlso>http://aims.fao.org/aos/agrovoc/c_2794</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Fertilizer -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Fertilizer">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriInput"/>
        <rdfs:label xml:lang="en">fertilizer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Fertilizing -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Fertilizing">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriActivity"/>
        <rdfs:label xml:lang="en">fertilizing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Fungicide -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Fungicide">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#PhytoSanitaryAgriInput"/>
        <rdfs:label xml:lang="en">fungicide</rdfs:label>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Harvesting -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Harvesting">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriActivity"/>
        <rdfs:label xml:lang="en">harvesting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Herbicide -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Herbicide">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#PhytoSanitaryAgriInput"/>
        <rdfs:label xml:lang="en">herbicide</rdfs:label>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Insecticide -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Insecticide">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#PhytoSanitaryAgriInput"/>
        <rdfs:label xml:lang="en">insecticide</rdfs:label>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#InterRow -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#InterRow">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Area"/>
        <rdfs:label xml:lang="en">inter row</rdfs:label>
    </owl:Class>
    


    <!-- http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Irrigation -->

    <owl:Class rdf:about="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#Irrigation">
        <rdfs:subClassOf rdf:resource="http://www.mistea.supagro.inra.fr/ontologies/2015/aeo#AgriActivity"/>
